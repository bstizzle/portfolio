---
import type { FeaturedProject } from '../../data/site';

interface Props {
  project: FeaturedProject;
  imageSrc?: string;
}

const { project, imageSrc: imageOverride } = Astro.props;

const techCategories = project.techCategories;
const image = 'image' in project ? (project.image as string) : undefined;
const imageAlt = 'imageAlt' in project ? (project.imageAlt as string) : '';
const imageSrc = imageOverride ?? (image ? (image.startsWith('/') ? image : `/${image}`) : undefined);

// Accepts YouTube watch, youtu.be, or embed links and returns an embeddable URL.
function toEmbedUrl(url: string): string {
  const yt = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{11})/);
  if (yt) return `https://www.youtube.com/embed/${yt[1]}`;
  const vimeo = url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}`;
  return url;
}
const videoSrc = 'video' in project && project.video ? toEmbedUrl(project.video as string) : undefined;
const videoTitle = 'videoTitle' in project ? (project.videoTitle as string) : (project as FeaturedProject).title;
---

<article class="scroll-stat panel-card group space-y-6">
  <header>
    <h3 class="text-2xl font-semibold text-slate">
      {project.title}
    </h3>
    {project.period && <p class="mt-1 font-mono text-sm text-accent">{project.period}</p>}
  </header>

  {videoSrc ? (
    <div class="w-full max-w-3xl overflow-hidden rounded-xl" style="aspect-ratio: 16 / 9;">
      <iframe
        src={videoSrc}
        title={videoTitle}
        class="h-full w-full"
        style="border: 0;"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
  ) : imageSrc && (
    <div class="w-full max-w-3xl overflow-hidden rounded-xl">
      <img
        src={imageSrc}
        alt={imageAlt}
        class="w-full h-56 object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class="space-y-4">
    <p class="body-copy">{project.summary}</p>

    {project.solution && (
      <div>
        <dt class="text-xs uppercase tracking-wider text-accent">Solution</dt>
        <dd class="mt-1.5 text-slate">{project.solution}</dd>
      </div>
    )}
    {project.impact && (
      <div>
        <dt class="text-xs uppercase tracking-wider text-accent">Impact</dt>
        <dd class="mt-1.5 text-slate">{project.impact}</dd>
      </div>
    )}
  </div>

  <div>
    <dt class="mb-3 text-xs uppercase tracking-wider text-accent">Technologies / Tools</dt>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {techCategories.map((techCat) => (
        <div>
          <h4 class="mb-2 text-xs uppercase tracking-wider text-slate-lightest">
            {techCat.category}
          </h4>
          <ul class="space-y-1">
            {techCat.items.map((item) => (
              <li class="text-sm text-slate-light">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</article>

<style>
  .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-stat.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  function revealCards() {
    const cards = document.querySelectorAll('.scroll-stat');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = Array.from(cards).indexOf(entry.target);
          setTimeout(() => {
            entry.target.classList.add('reveal');
          }, (index % 3) * 150); 
          
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -10px 0px'
    });

    cards.forEach(card => observer.observe(card));
  }

  revealCards();
  
  document.addEventListener('astro:after-swap', revealCards);
</script>